{
  "expo": {
    "name": "Godzilla Banger",
    "slug": "godzilla-banger",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/godzilla_banger_emblem.jpg",
    "splash": {
      "image": "./assets/images/godzilla_banger_emblem.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#060913"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.godzilla.banger",
      "icon": "./assets/images/godzilla_banger_emblem.jpg",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Godzilla Banger needs Bluetooth to connect to and control your Godzilla Banger device.",
        "NSBluetoothPeripheralUsageDescription": "Godzilla Banger needs Bluetooth to communicate with your Godzilla Banger hardware."
      }
    },
    "android": {
      "package": "com.godzilla.banger",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/godzilla_banger_emblem.jpg",
        "backgroundColor": "#060913"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow Godzilla Banger to connect to your Godzilla Banger device."
        }
      ],
      "expo-audio"
    ]
  }
}
